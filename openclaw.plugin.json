{
  "id": "obsidian-memory-plugin",
  "name": "Obsidian Memory",
  "version": "0.6.0",
  "description": "Load the bundled self-growing memory skill and an explicit Obsidian connection.",
  "skills": ["./skills"],
  "activation": { "onStartup": true, "onCapabilities": ["hook"] },
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "anyOf": [
      { "maxProperties": 0 },
      { "required": ["agentId", "vaultPath"] },
      { "required": ["agentConfigs"] },
      { "required": ["memoryJudge"] }
    ],
    "properties": {
      "agentId": { "type": "string", "minLength": 1, "maxLength": 128 },
      "vault": { "type": "string", "minLength": 1, "maxLength": 256 },
      "vaultPath": { "type": "string", "minLength": 1, "maxLength": 4096 },
      "cliPath": { "type": "string", "minLength": 1, "maxLength": 4096 },
      "projectId": {
        "type": "string", "maxLength": 128,
        "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]*$"
      },
      "projectRoot": { "type": "string", "minLength": 1, "maxLength": 4096 },
      "agentConfigs": {
        "type": "object", "minProperties": 1,
        "additionalProperties": {
          "type": "object", "additionalProperties": false,
          "required": ["vaultPath"],
          "properties": {
            "vault": { "type": "string", "minLength": 1, "maxLength": 256 },
            "vaultPath": { "type": "string", "minLength": 1, "maxLength": 4096 },
            "cliPath": { "type": "string", "minLength": 1, "maxLength": 4096 },
            "projectId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]*$" },
            "projectRoot": { "type": "string", "minLength": 1, "maxLength": 4096 }
          }
        }
      },
      "memoryJudge": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "mode": { "type": "string", "enum": ["off", "auto", "strict", "manual"], "default": "auto" },
          "endpoint": { "type": ["string", "null"] },
          "serviceFile": { "type": "string" },
          "timeout": { "type": "integer", "minimum": 50, "maximum": 60000, "default": 1000 },
          "coldStartTimeout": { "type": "integer", "minimum": 100, "maximum": 120000, "default": 7500 },
          "healthTimeout": { "type": "integer", "minimum": 20, "maximum": 10000, "default": 200 },
          "recallThreshold": { "type": "number", "minimum": 0.0, "maximum": 1.0, "default": 0.5 },
          "skipThreshold": { "type": "number", "minimum": 0.0, "maximum": 1.0, "default": 0.35 },
          "captureThreshold": { "type": "number", "minimum": 0.0, "maximum": 1.0, "default": 0.75 },
          "proactiveCapture": { "type": "boolean", "default": true },
          "consecutiveFailures": { "type": "integer", "minimum": 1, "maximum": 10, "default": 2 },
          "resetTimeout": { "type": "integer", "minimum": 1000, "maximum": 3600000, "default": 300000 },
          "discoveryInterval": { "type": "integer", "minimum": 1000, "maximum": 3600000, "default": 300000 }
        }
      }
    }
  },
  "uiHints": {
    "agentId": { "label": "OpenClaw agent ID" },
    "vault": { "label": "Vault label (optional; used only for CLI operations)" },
    "vaultPath": { "label": "Absolute Vault root path" },
    "cliPath": { "label": "CLI executable for Obsidian app operations (default: obsidian)" },
    "projectId": { "label": "Default project ID (optional)" },
    "projectRoot": { "label": "Actual code project root (optional)" },
    "memoryJudge": { "label": "Laya Optional Memory Judge settings (default mode: auto)" }
  }
}
